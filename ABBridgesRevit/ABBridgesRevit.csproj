<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AB Bridges for Revit 2025 (tab "AB Bridges" > panel "Revit Link")
    Build (Revit closed):  dotnet build -c Release
    Installs to %APPDATA%\Autodesk\Revit\Addins\2025 (ABBridges.addin + ABBridges folder).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>ABBridgesRevit</AssemblyName>
    <RootNamespace>ABBridgesRevit</RootNamespace>
    <Version>1.0.0</Version>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RevitVersion>2025</RevitVersion>
    <RevitPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>
    <NoWarn>$(NoWarn);MSB3277;CA1416</NoWarn>
    <AddinDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon_RF.png" />
    <EmbeddedResource Include="Resources\icon_CD.png" />
    <EmbeddedResource Include="Resources\icon_SS.png" />
    <EmbeddedResource Include="Resources\icon_BP.png" />
    <EmbeddedResource Include="Resources\icon_PD.png" />
    <EmbeddedResource Include="AB_logo_256.png" />
    <EmbeddedResource Include="AB.ico" />
  </ItemGroup>

  <ItemGroup>
    <FamilyFiles Include="Families\*.rfa" />
  </ItemGroup>

  <!-- install for Revit (close Revit before building) -->
  <Target Name="DeployAddin" AfterTargets="Build">
    <Copy SourceFiles="ABBridges.addin" DestinationFolder="$(AddinDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(AddinDir)\ABBridges" ContinueOnError="true" />
    <Copy SourceFiles="@(FamilyFiles)" DestinationFolder="$(AddinDir)\ABBridges\Families" ContinueOnError="true" />
    <Message Importance="high" Text="AB Bridges for Revit installed to $(AddinDir)" />
  </Target>

</Project>
